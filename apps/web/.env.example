# Environment Variables for Next.js Web UI

# API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# App Configuration
NEXT_PUBLIC_APP_NAME=Career AI Assistant
NEXT_PUBLIC_APP_DESCRIPTION=IBM Full Stack Cloud Developer Career Assistant

# Feature Flags
NEXT_PUBLIC_ENABLE_STUDY_PLANS=true
NEXT_PUBLIC_ENABLE_INTERVIEW_PREP=true

# Environment
NODE_ENV=development
